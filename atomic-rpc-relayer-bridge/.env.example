# Local metrics server bind address.
HOST=0.0.0.0
BRIDGE_PORT=8545
# PORT is also accepted by the local server; leave blank to use BRIDGE_PORT.
PORT=

# Comma-separated bridge endpoint URLs, ordered by priority.
BRIDGE_ENDPOINTS=http://127.0.0.1:8545

# Local relayer metrics sample values.
RELAYER_ADDRESS=GLOCALDEVRELAYER
INITIAL_NONCE=100
INITIAL_FAILED_TX_COUNT=0
