# Copy to `.env` and adjust for local Docker Compose.
# Secrets stay on the host — never commit a filled `.env`.

# --- scanner-engine ---
# Directory inside the scanner container to analyse (compose mounts SCAN_HOST_TARGET here).
SCAN_TARGET=/target
# Host path mounted at /target (default: ./docker/sample-target)
SCAN_HOST_TARGET=./docker/sample-target

# --- atomic-rpc-relayer-bridge (local metrics server) ---
BRIDGE_PORT=8545
RELAYER_ADDRESS=GLOCALDEVRELAYER
INITIAL_NONCE=100
INITIAL_FAILED_TX_COUNT=0

# --- anomaly-detector ---
RELAYER_METRICS_URL=http://atomic-rpc-relayer-bridge:8545/metrics
AUTHORIZED_ADDRESSES=GLOCALDEVRELAYER
NONCE_SPIKE_THRESHOLD=50
FAILED_TX_THRESHOLD=10
POLL_INTERVAL_MS=5000
# Optional comma-separated RPC URLs for node health / failover checks
RPC_NODE_URLS=
# Optional comma-separated threat-feed URLs
THREAT_FEED_URLS=

# --- verifiable-audit-trail ---
# Leave empty for dry-run hashing (no Stellar transaction).
AUDIT_KEYPAIR_SECRET=
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
