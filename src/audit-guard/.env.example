# Runtime mode.
NODE_ENV=development

# Audit Guard webhook configuration.
AUDIT_GUARD_WEBHOOK_URL=
AUDIT_GUARD_WEBHOOK_TOKEN=

# On-call roster and paging settings.
ONCALL_CONTACTS=[{"name":"Primary","email":"primary@example.com","role":"PRIMARY"}]
ONCALL_ROTATION_INTERVAL=weekly
ONCALL_PAGE_WEBHOOK_URL=
PAGE_SEVERITY=CRITICAL
PAGE_REPOSITORY=unknown

# Dashboard dispatch settings.
DASHBOARD_URL=
DASHBOARD_TOKEN=
GUARDIAN_DASH_URL=
GUARDIAN_DASH_TOKEN=

# Stellar audit anchoring. Leave AUDIT_KEYPAIR_SECRET blank for dry runs.
HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK=testnet
AUDIT_KEYPAIR_SECRET=

# Authorized relayers and emergency controls, comma-separated.
AUTHORIZED_ADDRESSES=
EMERGENCY_AUTHORIZED_ADDRESSES=

# Telemetry ingestion guard limits.
TELEMETRY_BUCKET_CAPACITY=100
TELEMETRY_REFILL_RATE_PER_SEC=50
TELEMETRY_MAX_QUEUE_DEPTH=500

# Multi-signature notification settings.
MULTISIG_WEBHOOK_SECRET=
MULTISIG_WEBHOOK_URLS=
MULTISIG_WEBHOOK_TIMEOUT_MS=5000

# Policy bundle signing and verification settings.
POLICY_BUNDLE_SIGNATURE=
POLICY_BUNDLE_SIGNERS=
POLICY_BUNDLE_SIGNING_SECRET=

# Maintenance-mode metadata for PR compliance checks.
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=

# CLI input and output paths.
EVENT_LOG_FILE=./logs/relay-events.log
REPORT_FILE=./reports/latest-report.md
SCAN_REPORT_FILE=./reports/latest-scan.json
PR_DATA_FILE=./pr-data.json
SOURCE_FILE=./src.ts
RBAC_POLICY_FILE=./rbac-policy.json
RBAC_FLAG_ADMIN=true
LOGIC_PATTERN_FILTER=
SECURITY_SEVERITY_THRESHOLD=3

# GitHub Actions PR metadata used by scripts/extract-pr-data.js.
GITHUB_PR_TITLE=
GITHUB_PR_BODY=
GITHUB_PR_LABELS=
GITHUB_BASE_BRANCH=main
GITHUB_HEAD_BRANCH=
GITHUB_PR_NUMBER=0
GITHUB_PR_AUTHOR=
GITHUB_ADDITIONS=0
GITHUB_DELETIONS=0
GITHUB_CHANGED_FILES=[]

# Archive and backup utilities.
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_REGION=us-east-1
ARCHIVE_RETENTION_DAYS=30
ARCHIVE_S3_PREFIX=audit-logs/
ARCHIVE_LOGS_PATH=logs
BACKUP_SOURCE=logs
BACKUP_DEST=backups/logs
BACKUP_TARGET=logs-restored
LOG_SRC=logs
LOG_DEST=backups/logs
