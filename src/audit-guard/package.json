{
  "name": "@vero/audit-guard-policy-engine",
  "version": "1.0.0",
  "description": "OPA-based Policy as Code engine for PR compliance checks",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:ui": "esbuild src/ui/*.tsx --bundle --minify --outdir=dist/ui --loader:.css=text",
    "test": "jest",
    "test:rbac": "jest src/rbac-mapper.test.ts --runInBand",
    "test:rbac:coverage": "jest src/rbac-mapper.test.ts --runInBand --coverage --collectCoverageFrom=src/rbac-mapper.ts --coverageThreshold='{\"global\":{\"branches\":80,\"functions\":80,\"lines\":80,\"statements\":80}}'",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "evaluate": "ts-node src/cli.ts",
    "check-pr": "ts-node src/cli.ts pr",
    "scan-events": "ts-node src/cli.ts scan-events",
    "security-gate": "ts-node src/security-gate-cli.ts",
    "policy-bundle": "ts-node src/policy-bundle-cli.ts",
    "backup": "ts-node src/backup.ts backup",
    "restore": "ts-node src/backup.ts restore"
  },
  "keywords": [
    "opa",
    "policy-as-code",
    "security",
    "pr-compliance",
    "vero"
  ],
  "author": "Vero Security Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@stellar/stellar-sdk": "^12.3.0",
    "@types/pdfkit": "0.13.9",
    "axios": "^1.7.0",
    "dotenv": "^16.4.0",
    "pdfkit": "0.15.2",
    "typescript": "^5.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.0.0",
    "fast-check": "^3.22.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
