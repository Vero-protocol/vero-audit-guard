# Horizon server used for Stellar audit anchoring.
HORIZON_URL=https://horizon-testnet.stellar.org

# Maximum time for an on-demand Horizon verification lookup (1-120000 ms).
HORIZON_TIMEOUT_MS=10000

# Use "testnet" by default; set to "mainnet" only for production anchoring.
STELLAR_NETWORK=testnet

# Stellar secret key used to sign audit-anchor transactions.
# Leave blank for dry-run hash computation.
AUDIT_KEYPAIR_SECRET=

# Trusted public account that originates official audit anchors.
# Required for verification; when anchoring it must match the secret above.
AUDIT_ANCHOR_ACCOUNT=
