# RPC endpoints used for node health checks and failover, comma-separated.
RPC_NODE_URLS=https://rpc-primary.example,https://rpc-secondary.example

# Relayer metrics endpoint polled by the anomaly detector.
RELAYER_METRICS_URL=https://relayer.example/metrics

# Allowed relayer addresses, comma-separated. Leave empty to skip this check.
AUTHORIZED_ADDRESSES=

# Detection thresholds.
NONCE_SPIKE_THRESHOLD=50
FAILED_TX_THRESHOLD=10
POLL_INTERVAL_MS=5000
RELAYER_LATENCY_THRESHOLD_MS=2000

# RPC failover monitor tuning.
RPC_HEALTH_WINDOW=100
RPC_FAILOVER_LATENCY_THRESHOLD_MS=3000
RPC_SUCCESS_RATE_THRESHOLD=0.8

# Optional threat feed sources. Use either one URL or a comma-separated list.
THREAT_FEED_URL=
THREAT_FEED_URLS=

# Optional Guardian dashboard dispatch settings.
GUARDIAN_DASH_URL=
GUARDIAN_DASH_TOKEN=

# Telemetry ingestion guard limits.
TELEMETRY_BUCKET_CAPACITY=200
TELEMETRY_REFILL_RATE_PER_SEC=100
TELEMETRY_MAX_QUEUE_DEPTH=1000
